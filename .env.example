# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit real credentials.

# --- Web search tool (https://serper.dev) ---
SERPER_API_KEY=your-serper-key

# --- AWS Bedrock ---
# Prefer an IAM role / `aws configure` profile over long-lived keys when possible.
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# --- Aviation data sources ---
# aviationweather.gov, OpenSky (anonymous), eCFR and OurAirports need NO key.
# Windy Point Forecast API (free key): https://api.windy.com/
WINDY_API_KEY=
# FAA NOTAM API (free registration): https://api.faa.gov/
FAA_NOTAM_CLIENT_ID=
FAA_NOTAM_CLIENT_SECRET=
# OpenSky account (optional — raises rate limits): https://opensky-network.org/
OPENSKY_USER=
OPENSKY_PASS=

# --- Swappable backends (local defaults need no cloud) ---
VECTOR_STORE=chroma
IMAGE_BACKEND=bedrock
STORAGE_BACKEND=local
JOB_STORE=memory

# --- Specialist agent toggles (true/false) ---
ENABLE_REGS_AGENT=true
ENABLE_WEATHER_AGENT=true
ENABLE_TRACKING_AGENT=true
ENABLE_AIRPORT_AGENT=true
ENABLE_AERO_ENG_AGENT=true

# --- MCP tool layer ---
# Run the server with: python -m app.mcp.server  (serves the URL below)
USE_MCP_TOOLS=true
MCP_TRANSPORT=streamable_http
MCP_AVIATION_URL=http://localhost:9000/mcp
